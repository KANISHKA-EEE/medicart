<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <base href="/" />
            <!-- CSRF Token -->
      <meta name="csrf-token" content="9eBmmIBtjgWIoBLl5e1zgAgvgFsnU5hUurmUtw7L">

        <!-- Favicon -->
      <link rel="shortcut icon" type="image/x-icon" href="https://www.wholesalepasalplus.com/images/frontend/favicon.ico">

  <title>System Maintenance</title>
  <style>
    /* CSS Variables for Emerald / Forest Green Theme */
    :root {
      --bg-dark: #071611;
      --bg-card: rgba(14, 38, 29, 0.72);
      --border-color: rgba(52, 211, 153, 0.2);
      --border-focus: #10b981;
      --primary: #10b981;
      --primary-hover: #059669;
      --primary-glow: rgba(16, 185, 129, 0.35);
      --text-main: #f0fdf4;
      --text-muted: #a7f3d0;
      --text-dim: #6ee7b7;
      --danger: #f87171;
      --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-family);
      min-height: 100vh;
      background-color: var(--bg-dark);
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      position: relative;
      overflow-x: hidden;
    }

    /* Ambient Glowing Spheres */
    .glow-sphere {
      position: fixed;
      border-radius: 50%;
      filter: blur(90px);
      z-index: 0;
      pointer-events: none;
      animation: float 14s ease-in-out infinite alternate;
    }

    .glow-sphere-1 {
      width: 320px;
      height: 320px;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.28) 0%, rgba(5, 150, 105, 0.05) 70%);
      top: -60px;
      left: -60px;
    }

    .glow-sphere-2 {
      width: 420px;
      height: 420px;
      background: radial-gradient(circle, rgba(52, 211, 153, 0.2) 0%, rgba(4, 120, 87, 0.05) 70%);
      bottom: -100px;
      right: -100px;
      animation-delay: -7s;
    }

    @keyframes  float {
      0% { transform: translateY(0) scale(1); }
      50% { transform: translateY(30px) scale(1.08); }
      100% { transform: translateY(-20px) scale(0.95); }
    }

    /* Main Container Card */
    .card {
      position: relative;
      z-index: 1;
      background: var(--bg-card);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid var(--border-color);
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), 0 0 30px rgba(16, 185, 129, 0.1);
      border-radius: 24px;
      max-width: 520px;
      width: 100%;
      padding: 2rem 1.5rem;
      text-align: center;
      transition: border-color 0.3s ease;
    }

    .card:hover {
      border-color: rgba(52, 211, 153, 0.35);
    }

    .logo_left{position: absolute; top: 15px; left: 10px; margin: auto;}
    .logo_right{position: absolute; top: 15px; right: 10px; margin: auto;}
    .logo_left .logo, .logo_right .logo{max-height: 130px; max-width: 130px;}

    /* Animated Icon Badge */
    .icon-wrapper {
      position: relative;
      width: 80px;
      height: 80px;
      margin: 0 auto 1.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .icon-pulse {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--primary-glow);
      animation: pulse 2.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    .icon-box {
      position: relative;
      width: 100%;
      height: 100%;
      background: rgba(16, 185, 129, 0.14);
      border: 1px solid rgba(52, 211, 153, 0.4);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #34d399;
    }

    .icon-box svg {
      width: 38px;
      height: 38px;
      transition: transform 0.4s ease;
    }

    .card:hover .icon-box svg {
      transform: rotate(45deg);
    }

    @keyframes  pulse {
      0%, 100% { transform: scale(0.95); opacity: 0.6; }
      50% { transform: scale(1.25); opacity: 0; }
    }

    /* Typography */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.825rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-dim);
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(52, 211, 153, 0.25);
      padding: 0.35rem 0.9rem;
      border-radius: 9999px;
      margin-bottom: 1.25rem;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      background-color: #34d399;
      border-radius: 50%;
      box-shadow: 0 0 8px #34d399;
    }

    h1 {
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 0.85rem;
      line-height: 1.2;
    }

    p {
      color: var(--text-muted);
      font-size: 1rem;
      line-height: 20px;
      margin-bottom: 2rem;
    }

    /* Key Input Form */
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      text-align: left;
    }

    label {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--text-dim);
      display: block;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-icon {
      position: absolute;
      left: 1rem;
      color: rgba(167, 243, 208, 0.6);
      display: flex;
      align-items: center;
      pointer-events: none;
    }

    input[type="password"],
    input[type="text"] {
      width: 100%;
      background: rgba(7, 22, 17, 0.75);
      border: 1.5px solid var(--border-color);
      border-radius: 12px;
      padding: 0.9rem 1rem 0.9rem 2.85rem;
      color: var(--text-main);
      font-size: 0.95rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    input::placeholder {
      color: rgba(167, 243, 208, 0.35);
    }

    input:focus {
      border-color: var(--border-focus);
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    }

    .submit-btn {
      width: 100%;
      background: var(--primary);
      color: #032014;
      font-weight: 600;
      font-size: 1rem;
      padding: 0.9rem;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      box-shadow: 0 4px 14px var(--primary-glow);
      transition: background-color 0.2s, transform 0.15s, box-shadow 0.2s;
    }

    .submit-btn:hover {
      background: var(--primary-hover);
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.45);
      transform: translateY(-1px);
    }

    .submit-btn:active {
      transform: translateY(0);
    }

    /* Feedback Alerts */
    .alert_message {
      background: #ff7f7f; color: #fff; padding: 0.5rem 1rem; 
      border:1px solid #ff4e4e; border-radius: 4px; margin-bottom: 0.5rem;
      position: absolute; top: -5px; right: 0; width: 50%; line-height: 15px;
    }

    /* Footer Meta */
    .footer-note {
      margin-top: 1rem;
      font-size: 0.8rem;
      color: rgba(167, 243, 208, 0.5);
    }

    /* Responsive Adjustments */
    @media (max-width: 480px) {
      .card {
        padding: 1.25rem 1rem;
        border-radius: 20px;
      }

      h1 {
        font-size: 1.65rem;
      }

      p {
        font-size: 0.925rem;
        margin-bottom: 1.25rem;
      }

      .icon-wrapper {
        width: 68px;
        height: 68px;
        margin-bottom: 1.25rem;
      }

      .icon-box svg {
        width: 32px;
        height: 32px;
      }
    }
  </style>
</head>
<body>

  <!-- Floating Green Glows -->
  <div class="glow-sphere glow-sphere-1"></div>
  <div class="glow-sphere glow-sphere-2"></div>

  <!-- Content Card -->
  <main class="card">
    <div class="logo_left">
      <img src='https://www.wholesalepasalplus.com/images/frontend/logo.png' alt="Wholesale Pasal" 
      class="logo">
    </div>
    <div class="logo_right">
      <img src='https://www.wholesalepasalplus.com/images/frontend/logo.png' alt="Wholesale Pasal" 
      class="logo">
    </div>
    <!-- Icon -->
    <div class="icon-wrapper">
      <div class="icon-pulse"></div>
      <div class="icon-box">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
        </svg>
      </div>
    </div>

    <!-- Status Badge -->
    <div class="status-badge">
      <span class="status-dot"></span> Under Maintenance
    </div>

    <!-- Headers -->
    <h1>We’ll Be Back Soon</h1>
    <p>Our site is under Maintenance. Our regular visitors are inconvenienced. We are really sorry for this. Please check back shortly, or enter your bypass key below.</p>

    <!-- Form -->
    <form method="get" id="maintenanceForm" action="https://www.wholesalepasalplus.com/uploads/product/HIMALAYA_BABY_LOTION_100ML1.png" style="position: relative;">
            <div class="form-group">
        <label for="maintenanceKey">Authorized Access</label>
        <div class="input-wrapper">
          <span class="input-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </span>
          <input 
            type="text" 
            id="maintenanceKey" 
            name="maintenance_key" 
            placeholder="Enter maintenance access key" 
            autocomplete="off"
            required
          />
          
        </div>
        <button type="submit" class="submit-btn" id="form-submit">
          <span>Authenticate</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </div>
    </form>

    <div class="footer-note">
      Expected completion: Within 24 hour &bull; Contact: wholesalepasalplus@gmail.com
    </div>
  </main>
</body>
</html>